# ============================================================
# Eisenhower Portfolio Manager — Environment Configuration
# ============================================================
#
# Copy this file to .env and update the values for your environment.
# DO NOT commit .env to version control — it contains secrets.
#
# Usage:
#   cp deploy/.env.example deploy/.env
#   # Edit deploy/.env with your actual secrets
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# SECURITY:
# - SECRET_KEY: Must be a cryptographically random string (≥44 characters, ≥256 bits entropy)
#   Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   The application will REFUSE TO START in production if SECRET_KEY is weak.
# - POSTGRES_PASSWORD: Must be a strong password (≥24 characters)
# - MINIO_SECRET_KEY: Must be a strong password (≥24 characters)
# ============================================================

# -----------------------------------------------------------
# Application
# -----------------------------------------------------------
# SECRET_KEY: Must be a cryptographically random string (≥44 characters, ≥256 bits entropy).
# In production, the application will REFUSE TO START if SECRET_KEY is a known default
# or has insufficient entropy. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Example output: aB3dE5fG7hI9jK1lM3nO5pQ7rS9tU1vW3xY5zA7bC9d
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_WITH_AT_LEAST_44_CHARS
APP_ENVIRONMENT=production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# -----------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------
POSTGRES_PASSWORD=eisenhower_secure_change_me
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=./volumes/postgres/data
POSTGRES_WAL_DIR=./volumes/postgres/wal

# -----------------------------------------------------------
# MinIO (S3-compatible object store)
# -----------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=./volumes/minio/data
MINIO_CONFIG_DIR=./volumes/minio/config

# -----------------------------------------------------------
# Redis
# -----------------------------------------------------------
REDIS_PORT=6379
REDIS_DATA_DIR=./volumes/redis/data

# -----------------------------------------------------------
# Backend
# -----------------------------------------------------------
BACKEND_PORT=8000
BACKEND_LOGS_DIR=./volumes/backend/logs
BACKEND_TMP_DIR=./volumes/backend/tmp

# -----------------------------------------------------------
# Frontend
# -----------------------------------------------------------
FRONTEND_PORT=8080

# -----------------------------------------------------------
# S3 Configuration (for artifact vault)
# -----------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=eisenhower-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me

# -----------------------------------------------------------
# Database URL (auto-constructed from POSTGRES_PASSWORD)
# Override if using external PostgreSQL
# -----------------------------------------------------------
# DATABASE_URL=postgresql://eisenhower:${POSTGRES_PASSWORD}@postgres:5432/eisenhower

# -----------------------------------------------------------
# Redis URL (auto-constructed)
# Override if using external Redis
# -----------------------------------------------------------
# REDIS_URL=redis://redis:6379/0
