# ============================================================
# Eisenhower Portfolio Manager — Backend Dockerfile (Offline)
# ============================================================
#
# Offline variant of the backend Dockerfile. Uses pre-downloaded
# Python wheels from the local wheelhouse instead of PyPI.
#
# Build context: Project root (same as docker-compose.offline-build.yml)
#
# Usage:
#   docker compose -f deploy/docker-compose.offline-build.yml build backend
#
# Prerequisites:
#   - deploy/offline/wheelhouse/ must contain all .whl files
#   - Run `python -m scripts.build_offline_bundle` first
# ============================================================

# -----------------------------------------------------------
# Build arguments
# -----------------------------------------------------------
ARG PIP_NO_INDEX=1
ARG PIP_FIND_LINKS="/offline/wheelhouse"

# -----------------------------------------------------------
# Stage 1: Builder — Install from local wheels
# -----------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Native dependencies for PostgreSQL, scientific computing, PDF
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libopenblas-dev \
    libfreetype6-dev \
    libfontconfig1-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy wheelhouse into the build context
COPY deploy/offline/wheelhouse/ /offline/wheelhouse/

# Install from local wheels only — no PyPI access
RUN pip install \
    --no-index \
    --find-links=/offline/wheelhouse \
    --no-deps \
    /offline/wheelhouse/*.whl \
    && pip freeze > /build/frozen.txt

# -----------------------------------------------------------
# Stage 2: Runtime — Minimal hardened image
# -----------------------------------------------------------
FROM python:3.11-slim-bookworm

LABEL org.opencontainers.image.title="Eisenhower Portfolio Manager Backend"
LABEL org.opencontainers.image.description="Enterprise defence portfolio management API (offline build)"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="Eisenhower Systems"
LABEL org.opencontainers.image.licenses="UNLICENSED"

ENV DEBIAN_FRONTEND=noninteractive

# Runtime-only native dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libopenblas0 \
    libfreetype6 \
    libfontconfig1 \
    libjpeg62-turbo \
    zlib1g \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get purge -y --auto-remove \
    && apt-get clean

# Create non-root user
RUN groupadd -g 10001 appgroup \
    && useradd -u 10001 -g appgroup -s /sbin/nologin -m appuser

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy application code
COPY app/ /app/app/
COPY init_db.py /app/init_db.py
COPY scripts/ /app/scripts/

# Create runtime directories
RUN mkdir -p /app/tmp /app/logs \
    && chown -R appuser:appgroup /app \
    && chmod -R 750 /app

# Environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENVIRONMENT=production \
    APP_SECRET_KEY=CHANGE_ME_IN_PRODUCTION \
    DATABASE_URL=postgresql://eisenhower:eisenhower@postgres:5432/eisenhower \
    REDIS_URL=redis://redis:6379/0 \
    S3_ENDPOINT_URL=http://minio:9000 \
    S3_BUCKET_NAME=eisenhower-artifacts \
    S3_ACCESS_KEY=minioadmin \
    S3_SECRET_KEY=minioadmin \
    JWT_ALGORITHM=HS256 \
    JWT_EXPIRATION_MINUTES=480

# Expose the API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Switch to non-root user
USER appuser

# Run with Gunicorn + Uvicorn workers
CMD ["gunicorn", "app.main:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--graceful-timeout", "30", \
     "--access-logfile", "/app/logs/access.log", \
     "--error-logfile", "/app/logs/error.log"]
