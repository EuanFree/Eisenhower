# ============================================================
# Eisenhower Portfolio Manager — Frontend Dockerfile (Offline)
# ============================================================
#
# Offline variant of the frontend Dockerfile. Uses pre-downloaded
# npm packages from the local cache instead of the npm registry.
#
# Build context: Project root (same as docker-compose.offline-build.yml)
#
# Usage:
#   docker compose -f deploy/docker-compose.offline-build.yml build frontend
#
# Prerequisites:
#   - deploy/offline/npm_cache/ must contain npm cache and/or tarballs
#   - Run `python -m scripts.build_offline_bundle` first
# ============================================================

# -----------------------------------------------------------
# Build arguments
# -----------------------------------------------------------
ARG NPM_CACHE_DIR="/offline/npm_cache/npm-cache"

# -----------------------------------------------------------
# Stage 1: Builder — Compile from local npm cache
# -----------------------------------------------------------
FROM node:20-slim AS builder

LABEL org.opencontainers.image.title="Eisenhower Frontend Builder (offline)"

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /build

# Copy npm cache into the build context
COPY deploy/offline/npm_cache/ /offline/npm_cache/

# Copy package files first
COPY frontend/package.json frontend/package-lock.json* /build/

# Install from local cache only — no registry access
# Try npm ci first (strict), fall back to npm install
RUN npm config set cache /offline/npm_cache/npm-cache \
    && npm config set prefer-offline true \
    && npm ci --no-audit --no-fund --loglevel=error \
    || npm install --cache /offline/npm_cache/npm-cache \
                    --prefer-offline \
                    --no-audit \
                    --no-fund \
                    --loglevel=error

# Copy the full frontend source
COPY frontend/ /build/

# Copy vendored fonts into the public directory
COPY frontend/public/fonts/ /build/public/fonts/

# Build the production bundle
RUN npm run build

# -----------------------------------------------------------
# Stage 2: Runtime — Hardened Nginx
# -----------------------------------------------------------
FROM nginx:1.25-alpine

LABEL org.opencontainers.image.title="Eisenhower Portfolio Manager Frontend"
LABEL org.opencontainers.image.description="Hardened Nginx serving compiled React assets (offline build)"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="Eisenhower Systems"
LABEL org.opencontainers.image.licenses="UNLICENSED"

# Copy compiled assets from builder
COPY --from=builder /build/dist/ /usr/share/nginx/html/

# Copy hardened Nginx configuration
COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf

# Remove default Nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Create unprivileged system user and group for runtime
# nginx:1.25-alpine includes a built-in 'nginx' user (UID 101), but we
# create an explicit unprivileged user to match the backend Dockerfile
# convention and enforce defense-in-depth.
RUN addgroup -g 10001 -S appgroup \
    && adduser -u 10001 -G appgroup -S -s /sbin/nologin appuser

# Create cache directories and set permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx /var/run \
    && chown -R appuser:appgroup /var/cache/nginx /var/log/nginx /var/run \
    && chown -R appuser:appgroup /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/ || exit 1

# Expose the frontend port
EXPOSE 8080

# Switch to unprivileged user for runtime
# Note: nginx.conf 'user' directive is set to 'appuser' to match
USER 10001:10001

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
